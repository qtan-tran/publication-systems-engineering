\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-module-canonical-locators}[2026/09/08 v1.2.0-alpha PSE canonical locators]
\RequirePackage{expl3}\RequirePackage{xparse}
\ExplSyntaxOn
\prop_new:N \g_pse_locator_prop
\cs_new_protected:Npn \pse_locator_register:nn #1#2 {
  \prop_if_in:NnTF \g_pse_locator_prop {#1::#2}
    { \PackageError{pse-module-canonical-locators}{Duplicate canonical locator `#1::#2'}{Locator identifiers must be unique within a namespace.} }
    { \prop_gput:Nnn \g_pse_locator_prop {#1::#2} {1} }
}
\NewDocumentCommand{\PSELocatorNS}{m m}{\pse_locator_register:nn {#1}{#2}\hypertarget{pse-loc-#1-#2}{}\label{pse-loc:#1:#2}\leavevmode\makebox[0pt][r]{\sffamily\scriptsize #2\hspace{1.1em}}}
\NewDocumentCommand{\PSELocatorRefNS}{m m}{\hyperlink{pse-loc-#1-#2}{#2}}
\NewDocumentCommand{\PSELocatorRangeRefNS}{m m m}{\PSELocatorRefNS{#1}{#2}--\PSELocatorRefNS{#1}{#3}}
\NewDocumentCommand{\PSELocator}{m}{\PSELocatorNS{canonical}{#1}}
\NewDocumentCommand{\PSELocatorRef}{m}{\PSELocatorRefNS{canonical}{#1}}
\NewDocumentCommand{\PSELocatorRangeRef}{m m}{\PSELocatorRangeRefNS{canonical}{#1}{#2}}
\ExplSyntaxOff\endinput
