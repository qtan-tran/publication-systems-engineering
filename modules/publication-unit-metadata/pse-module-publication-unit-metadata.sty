\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-module-publication-unit-metadata}[2026/09/11 v1.0.0-alpha PSE publication-unit metadata]
\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{pse-module-contributor-metadata}

% Profiles own visual rendering. The semantic module supplies data and iterators.
\providecommand{\PSEPublicationUnitContributorPresentation}[4]{#1}
\providecommand{\PSEPublicationUnitPresentation}[6]{%
  \chapter{#2}%
  \PSEPublicationUnitContributors{#1}{author}%
  \if\relax\detokenize{#4}\relax\else\par\noindent #4\par\fi%
}

\ExplSyntaxOn
\prop_new:N \g_pse_unit_title_prop
\prop_new:N \g_pse_unit_subtitle_prop
\prop_new:N \g_pse_unit_abstract_prop
\prop_new:N \g_pse_unit_keywords_prop
\prop_new:N \g_pse_unit_doi_prop
\seq_new:N \g_pse_unit_contributions_seq

\cs_new_protected:Npn \pse_unit_require:n #1 {
  \prop_if_in:NnF \g_pse_unit_title_prop {#1}
    {\PackageError{pse-module-publication-unit-metadata}{Unknown publication unit id `#1'}{Declare the publication unit before assigning metadata.}}
}
\cs_new_protected:Npn \pse_unit_set_once:Nnn #1#2#3 {
  \pse_unit_require:n {#2}
  \prop_if_in:NnTF #1 {#2}
    {\PackageError{pse-module-publication-unit-metadata}{Duplicate metadata for publication unit `#2'}{Each metadata field may be assigned once.}}
    {\prop_gput:Nnn #1 {#2}{#3}}
}
\cs_new:Npn \pse_unit_get:Nn #1#2 {\prop_item:Nn #1 {#2}}
\cs_new_protected:Npn \pse_unit_contributor_item:nnn #1#2#3 {
  \str_if_eq:eeT {#2}{\l_pse_unit_filter_unit_tl} {
    \str_if_eq:eeT {#3}{\l_pse_unit_filter_role_tl} {
      \PSEPublicationUnitContributorPresentation
        {\PSEContributorName{#1}}{\PSEContributorAffiliation{#1}}{\PSEContributorORCID{#1}}{#3}
    }
  }
}
\tl_new:N \l_pse_unit_filter_unit_tl
\tl_new:N \l_pse_unit_filter_role_tl

\NewDocumentCommand{\PSEDeclarePublicationUnit}{m m}{
  \prop_if_in:NnTF \g_pse_unit_title_prop {#1}
    {\PackageError{pse-module-publication-unit-metadata}{Duplicate publication unit id `#1'}{Publication unit ids must be unique.}}
    {\prop_gput:Nnn \g_pse_unit_title_prop {#1}{#2}}
}
\NewDocumentCommand{\PSEPublicationUnitSubtitle}{m m}{\pse_unit_set_once:Nnn \g_pse_unit_subtitle_prop {#1}{#2}}
\NewDocumentCommand{\PSEPublicationUnitAbstract}{m m}{\pse_unit_set_once:Nnn \g_pse_unit_abstract_prop {#1}{#2}}
\NewDocumentCommand{\PSEPublicationUnitKeywords}{m m}{\pse_unit_set_once:Nnn \g_pse_unit_keywords_prop {#1}{#2}}
\NewDocumentCommand{\PSEPublicationUnitDOI}{m m}{\pse_unit_set_once:Nnn \g_pse_unit_doi_prop {#1}{#2}}
\NewDocumentCommand{\PSEPublicationUnitContributor}{m m m}{
  \pse_unit_require:n {#1}
  \PSERegisterContribution{#2}{#1}{#3}
  \seq_gput_right:Nn \g_pse_unit_contributions_seq {{#2}{#1}{#3}}
}
\NewDocumentCommand{\PSEPublicationUnitContributors}{m m}{
  \tl_set:Nn \l_pse_unit_filter_unit_tl {#1}
  \tl_set:Nn \l_pse_unit_filter_role_tl {#2}
  \seq_map_inline:Nn \g_pse_unit_contributions_seq {\pse_unit_contributor_item:nnn ##1}
}
\NewDocumentCommand{\PSEOpenPublicationUnit}{m}{
  \pse_unit_require:n {#1}
  \PSEPublicationUnitPresentation{#1}
    {\pse_unit_get:Nn \g_pse_unit_title_prop {#1}}
    {\pse_unit_get:Nn \g_pse_unit_subtitle_prop {#1}}
    {\pse_unit_get:Nn \g_pse_unit_abstract_prop {#1}}
    {\pse_unit_get:Nn \g_pse_unit_keywords_prop {#1}}
    {\pse_unit_get:Nn \g_pse_unit_doi_prop {#1}}
}
\ExplSyntaxOff
\endinput
