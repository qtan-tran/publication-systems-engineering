\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-profile-bilingual-edition}[2026/09/08 v1.7.0-alpha PSE neutral bilingual profile]
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{paracol}

% ---- integrated presentation declaration ---------------------------------
\PSEConfigureIntegratedPresentation{parallel-edition}{structured}{available}{asymmetric-scholarly}{outer-margin}{available}{source-defined}{profile-controlled}

% ---- typography role overrides -------------------------------------------
\renewcommand{\PSETypographyBodyRole}{\rmfamily\normalsize\mdseries\upshape}
\renewcommand{\PSETypographyDisplayRole}{\sffamily\mdseries\upshape}
\renewcommand{\PSETypographyChapterTitleRole}{\rmfamily\Large\bfseries\upshape}
\renewcommand{\PSETypographySectionHeadingRole}{\rmfamily\large\bfseries\upshape}
\renewcommand{\PSETypographySubsectionHeadingRole}{\rmfamily\normalsize\bfseries\upshape}
\renewcommand{\PSETypographyMetadataLabelRole}{\PSETypographyDisplayRole\small\bfseries\upshape}
\renewcommand{\PSETypographyMetadataValueRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyRunningHeadRole}{\PSETypographyDisplayRole\scriptsize\mdseries\upshape}
\renewcommand{\PSETypographyCaptionRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyApparatusRole}{\rmfamily\small\mdseries\upshape}

% ---- page-grid configuration ---------------------------------------------
\PSEConfigurePageGrid{18mm}{20mm}{19mm}{24mm}{11pt}{5.5mm}{10mm}{0mm}
\PSEApplyPageGrid
\PSEUseOuterMarginObjects{12mm}{3mm}
\AtBeginDocument{\PSETypographyBodyRole\linespread{1.045}\selectfont\setlength{\parindent}{1.05em}\setlength{\parskip}{0pt}}
\setlength{\emergencystretch}{0.8em}\widowpenalty=8000\clubpenalty=8000\raggedbottom
\titleformat{\chapter}[display]{\normalfont\color{PSEText}}{\PSETypographyDisplayRole\scriptsize\MakeUppercase{\chaptername}\enspace\thechapter}{7pt}{\PSETypographyChapterTitleRole\centering}
\titlespacing*{\chapter}{0pt}{20pt}{22pt}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\PSETypographyDisplayRole\scriptsize\MakeUppercase{\PSETitle}}\fancyhead[RO]{\scriptsize\nouppercase{\leftmark}}\fancyhead[RE,LO]{\scriptsize\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\scriptsize\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\providecommand{\PSEBilingualLayoutMode}{parallel-columns}
\providecommand{\PSEBilingualSourceLanguage}{source}
\providecommand{\PSEBilingualTargetLanguage}{target}
\providecommand{\PSEBilingualShowLanguageLabels}{true}
\providecommand{\PSEBilingualLongSegmentPolicy}{flow}
\newcommand{\PSEBilingualRoleLabel}[1]{\par\noindent{\PSETypographyDisplayRole\scriptsize\bfseries\MakeUppercase{#1}}\par\smallskip}
\newcommand{\PSEBilingualMaybeLabel}[1]{\ifdefstring{\PSEBilingualShowLanguageLabels}{true}{\PSEBilingualRoleLabel{#1}}{}}
\providecommand{\PSEParallelSegmentPresentation}[3]{}
\newcommand{\PSEBilingualSequentialBlock}[2]{%
  \par\Needspace{6\baselineskip}\vspace{0.55\baselineskip}%
  \PSEBilingualMaybeLabel{\PSEBilingualSourceLanguage}#1\par\medskip
  \PSEBilingualMaybeLabel{\PSEBilingualTargetLanguage}#2\par
  \vspace{0.55\baselineskip}}
\newcommand{\PSEBilingualSourceDominantBlock}[2]{%
  \par\Needspace{6\baselineskip}\vspace{0.55\baselineskip}%
  \PSEBilingualMaybeLabel{\PSEBilingualSourceLanguage}#1\par\smallskip
  {\small\leftskip=1.2em\rightskip=0pt plus 1fil\PSEBilingualMaybeLabel{\PSEBilingualTargetLanguage}#2\par}%
  \vspace{0.55\baselineskip}}
\newcommand{\PSEBilingualTargetDominantBlock}[2]{%
  \par\Needspace{6\baselineskip}\vspace{0.55\baselineskip}%
  \PSEBilingualMaybeLabel{\PSEBilingualTargetLanguage}#2\par\smallskip
  {\small\leftskip=1.2em\rightskip=0pt plus 1fil\PSEBilingualMaybeLabel{\PSEBilingualSourceLanguage}#1\par}%
  \vspace{0.55\baselineskip}}
\providecommand{\PSEParallelAlignmentPresentation}[3]{%
  \ifdefstring{\PSEBilingualLayoutMode}{facing-pages}{%
    \clearpage\ifodd\value{page}\null\thispagestyle{empty}\newpage\fi
    \PSEBilingualMaybeLabel{\PSEBilingualSourceLanguage}#2\par
    \newpage
    \PSEBilingualMaybeLabel{\PSEBilingualTargetLanguage}#3\par
  }{\ifdefstring{\PSEBilingualLayoutMode}{sequential-blocks}{%
    \PSEBilingualSequentialBlock{#2}{#3}%
  }{\ifdefstring{\PSEBilingualLayoutMode}{source-dominant}{%
    \PSEBilingualSourceDominantBlock{#2}{#3}%
  }{\ifdefstring{\PSEBilingualLayoutMode}{target-dominant}{%
    \PSEBilingualTargetDominantBlock{#2}{#3}%
  }{%
    \par\Needspace{7\baselineskip}\vspace{0.55\baselineskip}
    \begin{paracol}{2}
    {\raggedright\PSEBilingualMaybeLabel{\PSEBilingualSourceLanguage}#2\par}
    \switchcolumn
    {\raggedright\PSEBilingualMaybeLabel{\PSEBilingualTargetLanguage}#3\par}
    \end{paracol}
    \vspace{0.55\baselineskip}%
  }}}}}
\providecommand{\PSEParallelNotePresentation}[3]{\par\smallskip\noindent{\PSETypographyMetadataLabelRole\footnotesize #2 note. }{\footnotesize #3}\par\smallskip}
\providecommand{\PSEParallelTranslationNotePresentation}[2]{\PSEParallelNotePresentation{#1}{Translation}{#2}}
\renewcommand{\PSETitlePage}{%
  \thispagestyle{empty}\vspace*{0.16\textheight}\begin{center}
  {\PSETypographyDisplayRole\small\MakeUppercase{\PSEAuthor}\par}\vspace{2.1em}
  {\LARGE\bfseries \PSETitle\par}
  \ifdefempty{\pse@subtitle}{}{\vspace{0.8em}{\normalsize\itshape \PSESubtitle\par}}
  \vfill\ifdefempty{\pse@series}{}{\small \PSESeries\par\vspace{0.5em}}{\small \PSEPublicationYear\par}
  \end{center}\clearpage}

% ---- integrated presentation descriptor binding ----
\PSEConfigureIntegratedPresentation{parallel-edition}{structured}{available}{asymmetric-scholarly}{outer-margin}{available}{source-defined}{profile-controlled}
\endinput
