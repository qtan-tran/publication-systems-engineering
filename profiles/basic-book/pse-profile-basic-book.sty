\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-profile-basic-book}[2026/09/08 v1.0.0-alpha PSE neutral basic-book typography]

\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}

% ---- integrated presentation declaration ---------------------------------
\PSEConfigureIntegratedPresentation{book-reading}{structured}{available}{book}{fallback}{deferred}{none}{none}

% ---- typography role overrides -------------------------------------------
\renewcommand{\PSETypographyBodyRole}{\rmfamily\normalsize\mdseries\upshape}
\renewcommand{\PSETypographyDisplayRole}{\sffamily\mdseries\upshape}
\renewcommand{\PSETypographyChapterTitleRole}{\rmfamily\LARGE\bfseries\upshape}
\renewcommand{\PSETypographySectionHeadingRole}{\rmfamily\large\bfseries\upshape}
\renewcommand{\PSETypographySubsectionHeadingRole}{\rmfamily\normalsize\bfseries\upshape}
\renewcommand{\PSETypographyMetadataLabelRole}{\PSETypographyDisplayRole\small\bfseries\upshape}
\renewcommand{\PSETypographyMetadataValueRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyRunningHeadRole}{\PSETypographyDisplayRole\scriptsize\mdseries\upshape}
\renewcommand{\PSETypographyCaptionRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyApparatusRole}{\rmfamily\small\mdseries\upshape}

% --------------------------------------------------------------------------
% Profile scope
% --------------------------------------------------------------------------
% This package is deliberately neutral. It is a professional baseline for a
% general book, not a house style and not an imitation of any publisher.
% Title-local projects may override this profile in config/pse-local.tex.

% ---- page architecture ----------------------------------------------------
\PSEConfigurePageGrid{18mm}{22mm}{19mm}{23mm}{10pt}{5.5mm}{10mm}{0mm}
\PSEApplyPageGrid

% Optical balance for small/medium trade and scholarly trim sizes.


% ---- body typography ------------------------------------------------------
\AtBeginDocument{%
  \PSETypographyBodyRole
  \linespread{1.05}\selectfont
  \setlength{\parindent}{1.22em}%
  \setlength{\parskip}{0pt}%
}
\setlength{\emergencystretch}{0.75em}
\widowpenalty=7000
\clubpenalty=7000
\displaywidowpenalty=5000
\brokenpenalty=2500
\predisplaypenalty=8000
\postdisplaypenalty=2500
\raggedbottom

% Footnotes: quieter than the main text, but not compressed into illegibility.
\setlength{\footnotesep}{7.2pt}
\setlength{\skip\footins}{11.5pt plus 2pt minus 1pt}

% ---- chapter and section hierarchy ---------------------------------------
% The early technical fixture inherited an oversized class chapter style.
% This profile replaces it with a restrained hierarchy suitable as a baseline.
\titleformat{\chapter}[display]
  {\normalfont\color{PSEText}}
  {\sffamily\small\textls[70]{\MakeUppercase{\chaptername}\enspace\thechapter}}
  {8pt}
  {\PSETypographyChapterTitleRole\raggedright}
  []
\titlespacing*{\chapter}{0pt}{24pt}{28pt}

\titleformat{name=\chapter,numberless}[display]
  {\normalfont\color{PSEText}}
  {}
  {0pt}
  {\PSETypographyChapterTitleRole\raggedright}
  []
\titlespacing*{name=\chapter,numberless}{0pt}{24pt}{28pt}

\titleformat{\section}
  {\PSETypographySectionHeadingRole\raggedright}
  {\thesection}
  {0.65em}
  {}
\titlespacing*{\section}{0pt}{19pt plus 2pt minus 1pt}{7pt}

\titleformat{\subsection}
  {\PSETypographySubsectionHeadingRole\raggedright}
  {\thesubsection}
  {0.65em}
  {}
\titlespacing*{\subsection}{0pt}{14pt plus 2pt minus 1pt}{5pt}

% Keep ordinary headings away from the last one or two lines of a page.
\pretocmd{\section}{\Needspace{4\baselineskip}}{}{}
\pretocmd{\subsection}{\Needspace{10\baselineskip}}{}{}

% ---- running heads and folios --------------------------------------------
\setlength{\headheight}{12pt}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[LE]{\PSETypographyRunningHeadRole\textls[45]{\MakeUppercase{\PSETitle}}}
\fancyhead[RO]{\scriptsize\nouppercase{\leftmark}}
\fancyhead[RE,LO]{\scriptsize\thepage}

% Chapter-opening pages: folio only, centered at foot.
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[C]{\scriptsize\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

\renewcommand{\chaptermark}[1]{\markboth{#1}{}}

% ---- title and publication pages -----------------------------------------
\renewcommand{\PSETitlePage}{%
  \thispagestyle{empty}%
  \vspace*{0.145\textheight}%
  \begin{center}
    {\sffamily\small\textls[70]{\MakeUppercase{\PSEAuthor}}\par}
    \vspace{2.4em}
    {\LARGE\bfseries \PSETitle\par}
    \ifdefempty{\pse@subtitle}{}{\vspace{0.85em}{\normalsize\itshape \PSESubtitle\par}}
    \vfill
    \ifdefempty{\pse@series}{}{\small \PSESeries\par\vspace{0.5em}}
    {\small \PSEPublicationYear\par}
  \end{center}
  \clearpage
}

\renewcommand{\PSEPublicationPage}{%
  \thispagestyle{empty}%
  \vspace*{0.60\textheight}%
  {\footnotesize
  \noindent \PSETitle\par
  \noindent \PSEAuthor\par
  \noindent Publication year: \PSEPublicationYear\par
  \noindent Language: \PSELanguage\par
  \vspace{0.8em}
  \PSEAttributionBanner
  }
  \clearpage
}


% ---- integrated presentation descriptor binding ----
\PSEConfigureIntegratedPresentation{book-reading}{structured}{available}{book}{fallback}{deferred}{none}{none}
\endinput
