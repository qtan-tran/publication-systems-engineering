{
  "id": "basic-book",
  "version": "1.0.0-alpha",
  "extends": "pse-core",
  "generator_supported": true,
  "capabilities": [
    "prose",
    "chapters",
    "sections",
    "subsections",
    "running-heads",
    "footnotes",
    "index",
    "margin-objects"
  ],
  "required_metadata": [
    "title",
    "author",
    "language",
    "publication_year"
  ],
  "open_font_policy": true,
  "schema_version": "1.1",
  "description": "Neutral general book baseline.",
  "required_fonts": [],
  "module_policy": {
    "index": {
      "status": "recommended",
      "default_enabled": true
    },
    "structural-hierarchy": {
      "status": "required",
      "default_enabled": true
    },
    "publication-unit-metadata": {
      "status": "optional",
      "default_enabled": false
    },
    "contributor-metadata": {
      "status": "recommended",
      "default_enabled": false
    },
    "margin-objects": {
      "status": "optional",
      "default_enabled": false
    },
    "apparatus": {
      "status": "discouraged",
      "default_enabled": false
    }
  }
}
