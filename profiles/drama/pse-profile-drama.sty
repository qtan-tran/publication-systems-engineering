\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-profile-drama}[2026/09/08 v1.4.0-alpha PSE neutral drama profile]
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}

% ---- integrated presentation declaration ---------------------------------
\PSEConfigureIntegratedPresentation{dramatic-reading}{dramatic}{deferred}{asymmetric-scholarly}{outer-margin}{available}{primary-visible}{none}

% ---- typography role overrides -------------------------------------------
\renewcommand{\PSETypographyBodyRole}{\rmfamily\normalsize\mdseries\upshape}
\renewcommand{\PSETypographyDisplayRole}{\sffamily\mdseries\upshape}
\renewcommand{\PSETypographyChapterTitleRole}{\rmfamily\Large\bfseries\upshape}
\renewcommand{\PSETypographySectionHeadingRole}{\rmfamily\normalsize\bfseries\upshape}
\renewcommand{\PSETypographySubsectionHeadingRole}{\rmfamily\normalsize\bfseries\upshape}
\renewcommand{\PSETypographyMetadataLabelRole}{\PSETypographyDisplayRole\small\bfseries\upshape}
\renewcommand{\PSETypographyMetadataValueRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyRunningHeadRole}{\PSETypographyDisplayRole\scriptsize\mdseries\upshape}
\renewcommand{\PSETypographyCaptionRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyApparatusRole}{\rmfamily\small\mdseries\upshape}

% ---- page-grid configuration ---------------------------------------------
\PSEConfigurePageGrid{18mm}{22mm}{19mm}{24mm}{11pt}{5.5mm}{10mm}{0mm}
\PSEApplyPageGrid
\PSEUseOuterMarginObjects{13mm}{3mm}
\AtBeginDocument{\PSETypographyBodyRole\linespread{1.055}\selectfont\setlength{\parindent}{0pt}\setlength{\parskip}{0pt}}
\setlength{\emergencystretch}{0.8em}
\widowpenalty=8000
\clubpenalty=8000
\raggedbottom
\setlength{\footnotesep}{7.2pt}
\setlength{\skip\footins}{12pt plus 2pt minus 1pt}
\titleformat{\chapter}[display]{\normalfont\color{PSEText}}{\PSETypographyDisplayRole\scriptsize\MakeUppercase{\chaptername}\enspace\thechapter}{7pt}{\PSETypographyChapterTitleRole\centering}
\titlespacing*{\chapter}{0pt}{20pt}{22pt}
\titleformat{name=\chapter,numberless}[display]{\normalfont\color{PSEText}}{}{0pt}{\PSETypographyChapterTitleRole\centering}
\titlespacing*{name=\chapter,numberless}{0pt}{20pt}{22pt}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\PSETypographyDisplayRole\scriptsize\MakeUppercase{\PSETitle}}
\fancyhead[RO]{\scriptsize\nouppercase{\leftmark}}
\fancyhead[RE,LO]{\scriptsize\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\scriptsize\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\providecommand{\PSEDramaActPresentation}[1]{\par\Needspace{6\baselineskip}\vspace{1.4\baselineskip}\begin{center}\sffamily\small\bfseries\MakeUppercase{#1}\end{center}\vspace{0.7\baselineskip}}
\providecommand{\PSEDramaScenePresentation}[1]{\par\Needspace{5\baselineskip}\vspace{0.9\baselineskip}\begin{center}\itshape #1\end{center}\vspace{0.45\baselineskip}}
\providecommand{\PSEDramaSpeechStartPresentation}[1]{\par\Needspace{3\baselineskip}\vspace{0.35\baselineskip}\noindent{\PSETypographyDisplayRole\small\bfseries\MakeUppercase{#1}}\quad\ignorespaces}
\providecommand{\PSEDramaSpeechEndPresentation}{\par\vspace{0.35\baselineskip}}
\providecommand{\PSEDramaStageDirectionPresentation}[1]{\par\vspace{0.3\baselineskip}\begin{quote}\small\itshape #1\end{quote}\vspace{0.25\baselineskip}}
\providecommand{\PSEDramaCastHeadingPresentation}{\chapter*{Characters}}
\providecommand{\PSEDramaCastEntryPresentation}[1]{\noindent{\PSETypographyDisplayRole\small\bfseries #1}\par\smallskip}
\renewcommand{\PSETitlePage}{%
  \thispagestyle{empty}\vspace*{0.15\textheight}\begin{center}
  {\PSETypographyDisplayRole\small\MakeUppercase{\PSEAuthor}\par}\vspace{2.2em}
  {\LARGE\bfseries \PSETitle\par}
  \ifdefempty{\pse@subtitle}{}{\vspace{0.8em}{\normalsize\itshape \PSESubtitle\par}}
  \vfill\ifdefempty{\pse@series}{}{\small \PSESeries\par\vspace{0.5em}}{\small \PSEPublicationYear\par}
  \end{center}\clearpage}

% ---- integrated presentation descriptor binding ----
\PSEConfigureIntegratedPresentation{dramatic-reading}{dramatic}{deferred}{asymmetric-scholarly}{outer-margin}{available}{primary-visible}{none}
