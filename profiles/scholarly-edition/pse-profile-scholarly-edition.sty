\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-profile-scholarly-edition}[2026/09/08 v1.0.0-alpha PSE scholarly-edition baseline]
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}

% ---- integrated presentation declaration ---------------------------------
\PSEConfigureIntegratedPresentation{scholarly-edition}{compact}{available}{asymmetric-scholarly}{outer-margin}{multi-stream}{primary-visible}{none}

% ---- typography role overrides -------------------------------------------
\renewcommand{\PSETypographyBodyRole}{\rmfamily\normalsize\mdseries\upshape}
\renewcommand{\PSETypographyDisplayRole}{\sffamily\mdseries\upshape}
\renewcommand{\PSETypographyChapterTitleRole}{\rmfamily\Large\bfseries\upshape}
\renewcommand{\PSETypographySectionHeadingRole}{\rmfamily\large\bfseries\upshape}
\renewcommand{\PSETypographySubsectionHeadingRole}{\rmfamily\normalsize\bfseries\upshape}
\renewcommand{\PSETypographyMetadataLabelRole}{\PSETypographyDisplayRole\small\bfseries\upshape}
\renewcommand{\PSETypographyMetadataValueRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyRunningHeadRole}{\PSETypographyDisplayRole\scriptsize\mdseries\upshape}
\renewcommand{\PSETypographyCaptionRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyApparatusRole}{\rmfamily\small\mdseries\upshape}

% Neutral scholarly baseline. Semantic capabilities are provided by modules,
% not by this visual profile.

% ---- page-grid configuration ---------------------------------------------
\PSEConfigurePageGrid{19mm}{23mm}{19mm}{24mm}{11pt}{5.5mm}{10mm}{0mm}
\PSEApplyPageGrid
\PSEUseOuterMarginObjects{14mm}{3mm}
\AtBeginDocument{\PSETypographyBodyRole\linespread{1.045}\selectfont\setlength{\parindent}{1.18em}\setlength{\parskip}{0pt}}
\setlength{\emergencystretch}{0.8em}
\widowpenalty=8000
\clubpenalty=8000
\displaywidowpenalty=6000
\raggedbottom
\setlength{\footnotesep}{7.2pt}
\setlength{\skip\footins}{12pt plus 2pt minus 1pt}

\titleformat{\chapter}[display]
  {\normalfont\color{PSEText}}
  {\PSETypographyRunningHeadRole\textls[65]{\MakeUppercase{\chaptername}\enspace\thechapter}}
  {7pt}{\PSETypographyChapterTitleRole\raggedright}
\titlespacing*{\chapter}{0pt}{22pt}{24pt}
\titleformat{name=\chapter,numberless}[display]{\normalfont\color{PSEText}}{}{0pt}{\PSETypographyChapterTitleRole\raggedright}
\titlespacing*{name=\chapter,numberless}{0pt}{22pt}{24pt}
\titleformat{\section}{\PSETypographySectionHeadingRole\raggedright}{\thesection}{0.65em}{}
\titlespacing*{\section}{0pt}{17pt plus 2pt minus 1pt}{6pt}
\titleformat{\subsection}{\PSETypographySubsectionHeadingRole\raggedright}{\thesubsection}{0.65em}{}
\titlespacing*{\subsection}{0pt}{13pt plus 2pt minus 1pt}{5pt}
\pretocmd{\section}{\Needspace{4\baselineskip}}{}{}
\pretocmd{\subsection}{\Needspace{4\baselineskip}}{}{}

\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\PSETypographyRunningHeadRole\textls[40]{\MakeUppercase{\PSETitle}}}
\fancyhead[RO]{\scriptsize\nouppercase{\leftmark}}
\fancyhead[RE,LO]{\scriptsize\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\scriptsize\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}

\renewcommand{\PSETitlePage}{%
  \thispagestyle{empty}\vspace*{0.13\textheight}\begin{center}
  {\sffamily\small\textls[65]{\MakeUppercase{\PSEAuthor}}\par}\vspace{2.1em}
  {\LARGE\bfseries \PSETitle\par}
  \ifdefempty{\pse@subtitle}{}{\vspace{0.8em}{\normalsize\itshape \PSESubtitle\par}}
  \vfill\ifdefempty{\pse@series}{}{\small \PSESeries\par\vspace{0.5em}}{\small \PSEPublicationYear\par}
  \end{center}\clearpage}

% ---- integrated presentation descriptor binding ----
\PSEConfigureIntegratedPresentation{scholarly-edition}{compact}{available}{asymmetric-scholarly}{outer-margin}{multi-stream}{primary-visible}{none}
\endinput
