\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pse-profile-critical-edition}[2026/09/10 v1.0.0-alpha PSE critical-edition baseline]
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}

% ---- integrated presentation declaration ---------------------------------
\PSEConfigureIntegratedPresentation{source-critical}{compact}{available}{asymmetric-scholarly}{outer-margin}{multi-stream}{primary-visible}{none}

% ---- typography role overrides -------------------------------------------
\renewcommand{\PSETypographyBodyRole}{\rmfamily\normalsize\mdseries\upshape}
\renewcommand{\PSETypographyDisplayRole}{\sffamily\mdseries\upshape}
\renewcommand{\PSETypographyChapterTitleRole}{\rmfamily\large\bfseries\upshape}
\renewcommand{\PSETypographySectionHeadingRole}{\rmfamily\normalsize\bfseries\upshape}
\renewcommand{\PSETypographySubsectionHeadingRole}{\rmfamily\small\bfseries\upshape}
\renewcommand{\PSETypographyMetadataLabelRole}{\PSETypographyDisplayRole\small\bfseries\upshape}
\renewcommand{\PSETypographyMetadataValueRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyRunningHeadRole}{\PSETypographyDisplayRole\scriptsize\mdseries\upshape}
\renewcommand{\PSETypographyCaptionRole}{\rmfamily\small\mdseries\upshape}
\renewcommand{\PSETypographyApparatusRole}{\rmfamily\small\mdseries\upshape}

% Source-oriented critical-edition presentation. Semantic locators, apparatus,
% multilingual text, bibliography, index, and scholarly matter remain module-owned.

% ---- page-grid configuration ---------------------------------------------
\PSEConfigurePageGrid{19mm}{24mm}{18mm}{25mm}{11pt}{5mm}{10mm}{0mm}
\PSEApplyPageGrid
\PSEUseOuterMarginObjects{15mm}{3mm}
\AtBeginDocument{\PSETypographyBodyRole\linespread{1.025}\selectfont\setlength{\parindent}{1.05em}\setlength{\parskip}{0pt}}
\setlength{\emergencystretch}{0.7em}
\widowpenalty=9000
\clubpenalty=9000
\displaywidowpenalty=7000
\raggedbottom
\setlength{\footnotesep}{6.5pt}
\setlength{\skip\footins}{11pt plus 2pt minus 1pt}

% Critical editions benefit from compact hierarchy: the text and its locators
% remain visually primary while sectional intervention stays restrained.
\titleformat{\chapter}[display]
  {\normalfont\color{PSEText}}
  {\PSETypographyRunningHeadRole\textls[75]{\MakeUppercase{\chaptername}\enspace\thechapter}}
  {5.5pt}{\PSETypographyChapterTitleRole\raggedright}
\titlespacing*{\chapter}{0pt}{17pt}{18pt}
\titleformat{name=\chapter,numberless}[display]{\normalfont\color{PSEText}}{}{0pt}{\PSETypographyChapterTitleRole\raggedright}
\titlespacing*{name=\chapter,numberless}{0pt}{17pt}{18pt}
\titleformat{\section}{\PSETypographySubsectionHeadingRole\raggedright}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{13pt plus 2pt minus 1pt}{4.5pt}
\titleformat{\subsection}{\PSETypographySubsectionHeadingRole\raggedright}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{10pt plus 2pt minus 1pt}{4pt}
\pretocmd{\section}{\Needspace{4\baselineskip}}{}{}
\pretocmd{\subsection}{\Needspace{4\baselineskip}}{}{}

\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyhead[LE]{\scriptsize\thepage\hspace{1.25em}\sffamily\textls[45]{\MakeUppercase{\PSETitle}}}
\fancyhead[RO]{\scriptsize\nouppercase{\leftmark}\hspace{1.25em}\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\scriptsize\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}

\renewcommand{\PSETitlePage}{%
  \thispagestyle{empty}\vspace*{0.12\textheight}\begin{center}
  {\PSETypographyRunningHeadRole\textls[80]{\MakeUppercase{\PSEAuthor}}\par}\vspace{1.8em}
  {\Large\bfseries \PSETitle\par}
  \ifdefempty{\pse@subtitle}{}{\vspace{0.7em}{\normalsize\itshape \PSESubtitle\par}}
  \vfill\ifdefempty{\pse@series}{}{\small \PSESeries\par\vspace{0.45em}}{\small \PSEPublicationYear\par}
  \end{center}\clearpage}

% ---- integrated presentation descriptor binding ----
\PSEConfigureIntegratedPresentation{source-critical}{compact}{available}{asymmetric-scholarly}{outer-margin}{multi-stream}{primary-visible}{none}
\endinput
