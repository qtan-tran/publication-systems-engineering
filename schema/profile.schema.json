{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publication-systems-engineering.invalid/schema/profile.schema.json",
  "title": "PSE profile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "extends",
    "generator_supported",
    "capabilities",
    "required_metadata",
    "open_font_policy",
    "description"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "const": "pse-core"
    },
    "generator_supported": {
      "type": "boolean"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_metadata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_font_policy": {
      "const": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "semantic_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "required_fonts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "module_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "default_enabled"
        ],
        "properties": {
          "status": {
            "enum": [
              "required",
              "recommended",
              "optional",
              "discouraged",
              "incompatible"
            ]
          },
          "default_enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
