{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publication-systems-engineering.invalid/schema/presentation-profile-1.0.schema.json",
  "title": "PSE integrated presentation profile descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "preset",
    "hierarchy",
    "publication_unit_metadata",
    "grid",
    "side_material",
    "apparatus",
    "locator",
    "parallel_text",
    "description"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "preset": {
      "enum": [
        "book-reading",
        "scholarly-monograph",
        "parallel-edition",
        "source-critical",
        "dramatic-reading",
        "scholarly-collection",
        "fiction-reading",
        "verse-reading",
        "scholarly-edition"
      ]
    },
    "hierarchy": {
      "enum": [
        "structured",
        "compact",
        "dramatic",
        "verse",
        "narrative"
      ]
    },
    "publication_unit_metadata": {
      "enum": [
        "chapter-opener",
        "available",
        "deferred"
      ]
    },
    "grid": {
      "enum": [
        "book",
        "asymmetric-scholarly"
      ]
    },
    "side_material": {
      "enum": [
        "outer-margin",
        "fallback"
      ]
    },
    "apparatus": {
      "enum": [
        "multi-stream",
        "available",
        "deferred"
      ]
    },
    "locator": {
      "enum": [
        "primary-visible",
        "source-defined",
        "none"
      ]
    },
    "parallel_text": {
      "enum": [
        "profile-controlled",
        "none"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
