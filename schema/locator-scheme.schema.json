{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSE Canonical Locator Scheme",
  "type": "object",
  "required": ["schema_version", "id", "order", "require_complete", "strict_order"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "require_complete": {"type": "boolean"},
    "strict_order": {"type": "boolean"}
  },
  "additionalProperties": false
}
