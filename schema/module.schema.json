{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://publication-systems-engineering.invalid/schema/module.schema.json",
  "title": "PSE semantic module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_version",
    "id",
    "namespace",
    "version",
    "extends",
    "capabilities",
    "requires_capabilities",
    "build_tools",
    "required_fonts",
    "depends_on",
    "conflicts_with",
    "compatible_profiles",
    "qa_hooks",
    "description"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "api_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "const": "pse-core"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "build_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "biber",
          "makeindex"
        ]
      }
    },
    "required_fonts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "conflicts_with": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "compatible_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "qa_hooks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "locator-contract",
          "drama-contract",
          "parallel-text-contract"
        ]
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
