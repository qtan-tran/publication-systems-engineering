{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSE namespaced locator schemes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schemes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "schemes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "require_complete",
          "strict_order"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "require_complete": {
            "type": "boolean"
          },
          "strict_order": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
