{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pse/semantic-ir.schema.json",
  "title": "PSE Semantic Intermediate Representation",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "nodes",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "args",
          "location"
        ],
        "properties": {
          "kind": {
            "enum": [
              "command",
              "environment_begin"
            ]
          },
          "name": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "location": {
            "$ref": "#/$defs/location"
          }
        },
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "message",
          "location"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "location": {
            "$ref": "#/$defs/location"
          },
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "required": [
        "file",
        "line",
        "column",
        "offset"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
