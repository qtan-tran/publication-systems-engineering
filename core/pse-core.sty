\newcommand{\pse@proofwatermark}{%
  \AtPageCenter{%
    \makebox(0,0){%
      \rotatebox{35}{%
        \parbox{0.78\paperwidth}{\centering
          \color{black!9}\fontsize{26}{31}\selectfont\bfseries
          \pse@prooflabel\\[0.5em]
          \fontsize{12}{15}\selectfont\normalfont
          \pse@proofrecipient\quad\textbullet\quad\pse@proofid
        }%
      }%
    }%
  }%
  \AtPageLowerLeft{%
    \raisebox{7mm}[0pt][0pt]{\makebox[\paperwidth][c]{%
      \color{black!45}\sffamily\fontsize{6.8}{8}\selectfont
      \pse@prooflabel\enspace|\enspace \pse@proofrecipient\enspace|\enspace \pse@proofid
    }}%
  }%
}

% ---- page-grid contract ----------------------------------------------------
% The grid is a presentation contract. It fixes the physical page regions
% before composition begins; semantic modules may consume the resulting space
% but must not resize the grid dynamically after typesetting has started.
\newcommand{\PSEPageGridContractVersion}{1}
\newcommand\pse@gridinner{17mm}
\newcommand\pse@gridouter{21mm}
\newcommand\pse@gridtop{18mm}
\newcommand\pse@gridbottom{22mm}
\newcommand\pse@gridheadheight{11pt}
\newcommand\pse@gridheadsep{6mm}
\newcommand\pse@gridfootskip{10mm}
\newcommand\pse@gridapparatus{0mm}
\newcommand{\PSEConfigurePageGrid}[8]{%
  \renewcommand\pse@gridinner{#1}%
  \renewcommand\pse@gridouter{#2}%
  \renewcommand\pse@gridtop{#3}%
  \renewcommand\pse@gridbottom{#4}%
  \renewcommand\pse@gridheadheight{#5}%
  \renewcommand\pse@gridheadsep{#6}%
  \renewcommand\pse@gridfootskip{#7}%
  \renewcommand\pse@gridapparatus{#8}%
}
\newcommand{\PSEApplyPageGrid}{%
  \geometry{paperwidth=\pse@pagewidth,paperheight=\pse@pageheight,
    inner=\pse@gridinner,outer=\pse@gridouter,top=\pse@gridtop,
    bottom=\pse@gridbottom,headheight=\pse@gridheadheight,
    headsep=\pse@gridheadsep,footskip=\pse@gridfootskip}%
}
\newcommand{\PSEGridInnerGutter}{\pse@gridinner}
\newcommand{\PSEGridOuterMarginZone}{\pse@gridouter}
\newcommand{\PSEGridTopZone}{\pse@gridtop}
\newcommand{\PSEGridBottomZone}{\pse@gridbottom}
\newcommand{\PSEGridHeaderHeight}{\pse@gridheadheight}
\newcommand{\PSEGridHeaderSeparation}{\pse@gridheadsep}
\newcommand{\PSEGridFooterSeparation}{\pse@gridfootskip}
\newcommand{\PSEGridApparatusZone}{\pse@gridapparatus}
\newcommand{\PSEGridPrimaryTextMeasure}{\the\textwidth}
\PSEApplyPageGrid

% ---- integrated presentation-system contract ------------------------------
% Profiles compose established presentation contracts through a descriptor-
% matched runtime state. This layer owns no manuscript semantics.
\newcommand{\PSEIntegratedPresentationContractVersion}{1}
\newcommand\pse@presentationpreset{book-reading}
\newcommand\pse@presentationhierarchy{structured}
\newcommand\pse@presentationunitmetadata{available}
\newcommand\pse@presentationgrid{book}
\newcommand\pse@presentationside{fallback}
\newcommand\pse@presentationapparatus{deferred}
\newcommand\pse@presentationlocator{none}
\newcommand\pse@presentationparallel{none}
\newcommand{\PSEConfigureIntegratedPresentation}[8]{%
  \renewcommand\pse@presentationpreset{#1}%
  \renewcommand\pse@presentationhierarchy{#2}%
  \renewcommand\pse@presentationunitmetadata{#3}%
  \renewcommand\pse@presentationgrid{#4}%
  \renewcommand\pse@presentationside{#5}%
  \renewcommand\pse@presentationapparatus{#6}%
  \renewcommand\pse@presentationlocator{#7}%
  \renewcommand\pse@presentationparallel{#8}%
}
\newcommand{\PSEPresentationPreset}{\pse@presentationpreset}
\newcommand{\PSEPresentationHierarchyMode}{\pse@presentationhierarchy}
\newcommand{\PSEPresentationPublicationUnitMode}{\pse@presentationunitmetadata}
\newcommand{\PSEPresentationGridMode}{\pse@presentationgrid}
\newcommand{\PSEPresentationSideMaterialMode}{\pse@presentationside}
\newcommand{\PSEPresentationApparatusMode}{\pse@presentationapparatus}
\newcommand{\PSEPresentationLocatorMode}{\pse@presentationlocator}
\newcommand{\PSEPresentationParallelTextMode}{\pse@presentationparallel}

\newcommand{\PSEPresentationMetadataSeparator}{\relax}
\newcommand{\PSEPresentationChapterAccent}{\relax}

% ---- locator orchestration contract --------------------------------------
% Locator semantics remain owned by their existing modules. This core contract
% only declares which locator namespace a title/profile treats as primary or
% secondary and how visible numbering/stable identity are expected to behave.
% It does not register locators and therefore is not another locator engine.
\newcommand{\PSELocatorOrchestrationContractVersion}{1}
\newcommand\pse@locatorprimary{none}
\newcommand\pse@locatorsecondary{}
\newcommand\pse@locatorvisibility{profile-default}
\newcommand\pse@locatorstableids{required}
\newcommand{\PSEConfigureLocatorOrchestration}[4]{%
  \renewcommand\pse@locatorprimary{#1}%
  \renewcommand\pse@locatorsecondary{#2}%
  \renewcommand\pse@locatorvisibility{#3}%
  \renewcommand\pse@locatorstableids{#4}%
}
\newcommand{\PSEPrimaryLocatorNamespace}{\pse@locatorprimary}
\newcommand{\PSESecondaryLocatorNamespaces}{\pse@locatorsecondary}
\newcommand{\PSELocatorVisibilityPolicy}{\pse@locatorvisibility}
\newcommand{\PSELocatorStableIDPolicy}{\pse@locatorstableids}
\InputIfFileExists{build/pse-locator-orchestration.tex}{}{}

% ---- margin-object presentation contract ----------------------------------
% Semantic margin objects are module-owned. Core/profile presentation decides
% whether they occupy the outer margin or use an explicit fallback. No object
% may disappear merely because a layout lacks a usable margin zone.
\newcommand{\PSEMarginObjectPresentationContractVersion}{1}
\newcommand{\PSEMarginObjectMode}{fallback}
\newcommand{\PSESetMarginObjectMode}[1]{\renewcommand\PSEMarginObjectMode{#1}}
\newcommand{\PSEMarginObjectFallbackPresentation}[3]{%
  \par\smallskip\noindent{\PSETypographyCaptionRole #3}\par\smallskip}
\newcommand{\PSEMarginObjectPresentation}[3]{\PSEMarginObjectFallbackPresentation{#1}{#2}{#3}}
\newcommand{\PSEUseOuterMarginObjects}[2]{%
  \setlength{\marginparwidth}{#1}%
  \setlength{\marginparsep}{#2}%
  \renewcommand{\PSEMarginObjectMode}{outer-margin}%
  \renewcommand{\PSEMarginObjectPresentation}[3]{%
    \marginpar{\raggedright\PSETypographyCaptionRole ##3}}%
}

