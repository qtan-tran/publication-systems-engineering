% ---- publication attribution ----------------------------------------------
% PSE publication releases require the canonical attribution banner on either
% the publication/copyright page or a colophon. The release pipeline verifies
% that this macro actually rendered during the final build.
\newcommand{\PSEAttributionBanner}{%
  \par\vspace{1.35em}%
  \begin{center}%
    \includegraphics[width=0.94\linewidth]{pse-attribution-banner.png}%
  \end{center}%
  \typeout{PSE-ATTRIBUTION-BANNER: rendered}%
}

% ---- generic document primitives ----------------------------------------
\newcommand{\PSETitlePage}{%
  \thispagestyle{empty}%
  \vspace*{0.16\textheight}%
  \begin{center}
    {\Large \pse@author\par}
    \vspace{2.2em}
    {\fontsize{24}{27}\selectfont\bfseries \pse@title\par}
    \ifdefempty{\pse@subtitle}{}{\vspace{0.9em}{\large\itshape \pse@subtitle\par}}
    \vfill
    \ifdefempty{\pse@series}{}{{\small \pse@series\par}\vspace{0.5em}}
    {\small \pse@year\par}
  \end{center}
  \clearpage
}

\newcommand{\PSEPublicationPage}{%
  \thispagestyle{empty}%
  \vspace*{0.58\textheight}%
  {\small
  \noindent \pse@title\par
  \noindent \pse@author\par
  \noindent Publication year: \pse@year\par
  \noindent Language: \pse@language\par
  \vspace{0.8em}
  \PSEAttributionBanner
  }
  \clearpage
}

